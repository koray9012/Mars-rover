// --- System Pin Mapping & Configurations (Zero Conflict Layout) ---
#define ENA             22
#define IN1             15
#define IN2             2
#define IN3             4
#define IN4             32
#define BUTTON_PIN      34

// Servo Array Pins (Solar Panel & 3-Axis Arm: Spinner, Lifter, Gripper)
#define SERVO_PANEL     13
#define SERVO_ARM_SPIN  12
#define SERVO_ARM_LIFT  23
#define SERVO_ARM_GRIP  21

// GPS Module (GP-01 BDS+GPS) Hardware Serial 2
#define GPS_RX          16
#define GPS_TX          17

// OLED Display Specs
#define SCREEN_WIDTH    128
#define SCREEN_HEIGHT   64
#define OLED_RESET      -1
#define SCREEN_ADDRESS  0x3C

// --- Global Objects ---
WebServer server(80);
TinyGPSPlus gps;
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

Servo panelServo;
Servo armSpinServo;
Servo armLiftServo;
Servo armGripServo;

// --- ESP-NOW CONTROLLER STRUCT ---
typedef struct struct_message {
  int speedLeft;     
  int speedRight;    
  bool lmb;          
  bool rmb;
  bool mmb;
  bool isFrozen;     
} struct_message;

struct_message gloveData;

struct IdentityMessage {
  char name[32];
};
IdentityMessage robotIdentity;

unsigned long lastEspNowPacketTime = 0;
String espNowManualCmd = "STOP";
uint8_t controllerMac[6];
bool controllerKnown = false;
const char* ROBOT_NAME = "Mars-Rover";

// --- State Machine & Telemetry Variables ---
int currentMode = 0; // 0: Auto, 1: Manual+Safety, 2: Suicide, 3: Diagnostics
unsigned long lastButtonPress = 0;
bool lastButtonState = HIGH;

int panelPos = 0;
int armSpinPos = 90;
int armLiftPos = 90;
int armGripPos = 90;

unsigned long previousTelemetryMillis = 0;
const long telemetryInterval = 2000;

