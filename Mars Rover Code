// --- ESP-NOW RECEIVE & GLOVE DISCOVERY ---
void OnDataRecv(const esp_now_recv_info_t *recv_info, const uint8_t *incomingData, int len) {
  if (len == sizeof(struct_message)) {
    memcpy(&gloveData, incomingData, sizeof(gloveData));
    lastEspNowPacketTime = millis();

    if (gloveData.isFrozen) {
      espNowManualCmd = "STOP";
    } else if (gloveData.speedLeft > 50 && gloveData.speedRight > 50) {
      espNowManualCmd = "forward";
    } else if (gloveData.speedLeft < -50 && gloveData.speedRight < -50) {
      espNowManualCmd = "backward";
    } else if (gloveData.speedLeft < -20 && gloveData.speedRight > 20) {
      espNowManualCmd = "left";
    } else if (gloveData.speedLeft > 20 && gloveData.speedRight < -20) {
      espNowManualCmd = "right";
    } else {
      espNowManualCmd = "stop";
    }

    if (!controllerKnown && recv_info->src_addr != NULL) {
      memcpy(controllerMac, recv_info->src_addr, 6);
      esp_now_peer_info_t peerInfo = {};
      memcpy(peerInfo.peer_addr, controllerMac, 6);
      peerInfo.channel = 0;
      peerInfo.encrypt = false;
      if (esp_now_add_peer(&peerInfo) == ESP_OK) {
        controllerKnown = true;
      }
    }

    if (controllerKnown) {
      strncpy(robotIdentity.name, ROBOT_NAME, sizeof(robotIdentity.name));
      esp_now_send(controllerMac, (uint8_t *)&robotIdentity, sizeof(robotIdentity));
    }
  }
}

// --- Action Executing Helper ---
void executeCommand(String cmd) {
  if (cmd == "forward") {
    digitalWrite(IN1, HIGH); digitalWrite(IN2, LOW);
    digitalWrite(IN3, HIGH); digitalWrite(IN4, LOW);
  } else if (cmd == "backward") {
    digitalWrite(IN1, LOW); digitalWrite(IN2, HIGH);
    digitalWrite(IN3, LOW); digitalWrite(IN4, HIGH);
  } else if (cmd == "left") {
    digitalWrite(IN1, LOW); digitalWrite(IN2, HIGH);
    digitalWrite(IN3, HIGH); digitalWrite(IN4, LOW);
  } else if (cmd == "right") {
    digitalWrite(IN1, HIGH); digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW); digitalWrite(IN4, HIGH);
  } else if (cmd == "stop") {
    digitalWrite(IN1, LOW); digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW); digitalWrite(IN4, LOW);
  } else if (cmd == "panel_up") {
    panelPos = min(180, panelPos + 15);
    panelServo.write(panelPos);
  } else if (cmd == "panel_down") {
    panelPos = max(0, panelPos - 15);
    panelServo.write(panelPos);
  } else if (cmd == "spin_left") {
    armSpinPos = max(0, armSpinPos - 15);
    armSpinServo.write(armSpinPos);
  } else if (cmd == "spin_right") {
    armSpinPos = min(180, armSpinPos + 15);
    armSpinServo.write(armSpinPos);
  } else if (cmd == "lift_up") {
    armLiftPos = min(180, armLiftPos + 15);
    armLiftServo.write(armLiftPos);
  } else if (cmd == "lift_down") {
    armLiftPos = max(0, armLiftPos - 15);
    armLiftServo.write(armLiftPos);
  } else if (cmd == "grip_open") {
    armGripPos = min(180, armGripPos + 15);
    armGripServo.write(armGripPos);
  } else if (cmd == "grip_close") {
    armGripPos = max(0, armGripPos - 15);
    armGripServo.write(armGripPos);
  }
}

// --- Server Route Handlers ---
void handleRoot() {
  server.send(200, "text/html", MAIN_PAGE);
}

String getTelemetryPayload() {
  String payload = "";
  payload += "Mode: " + String(currentMode) + " | WiFi Clients: " + String(WiFi.softAPgetStationNum()) + "<br>";
  payload += "GPS Sats: " + String(gps.satellites.value()) + " | Fix: " + String(gps.location.isValid() ? "YES" : "NO") + "<br>";
  payload += "Lat: " + String(gps.location.lat(), 6) + " | Lng: " + String(gps.location.lng(), 6) + "<br>";
  payload += "Panel: " + String(panelPos) + "° | Spin: " + String(armSpinPos) + "°<br>";
  payload += "Lift: " + String(armLiftPos) + "° | Grip: " + String(armGripPos) + "°<br>";
  payload += "ESP-NOW Link: " + String((millis() - lastEspNowPacketTime < 1000) ? "OK" : "DISCONNECTED");
  return payload;
}

void handleTelemetryRequest() {
  server.send(200, "text/plain", getTelemetryPayload());
}

void handleAction() {
  String cmd = server.arg("go");
  executeCommand(cmd);
  server.send(200, "text/plain", getTelemetryPayload());
}

// --- Setup Routine ---
void setup() {
  Serial.begin(115200);
  Serial2.begin(9600, SERIAL_8N1, GPS_RX, GPS_TX); // GPS Initialization

  // Pin Configurations
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(BUTTON_PIN, INPUT_PULLUP);
  analogWrite(ENA, 220); // Default PWM throttle

  // Attach 4 Servos (1 Solar + 3 Arm)
  panelServo.attach(SERVO_PANEL);
  armSpinServo.attach(SERVO_ARM_SPIN);
  armLiftServo.attach(SERVO_ARM_LIFT);
  armGripServo.attach(SERVO_ARM_GRIP);

  // Initial Servo Positions
  panelServo.write(0);
  armSpinServo.write(90);
  armLiftServo.write(90);
  armGripServo.write(90);

  // OLED Display Initialization
  Wire.begin(21, 22);
  if(!display.begin(SSD1306_SWITCHCAPVCC, SCREEN_ADDRESS)) {
    Serial.println(F("SSD1306 allocation failed"));
  } else {
    display.clearDisplay();
    display.setTextSize(1);
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(0,0);
    display.println(F("Mars Rover 2.0 Booting"));
    display.display();
  }

  // Access Point & ESP-NOW Initialization
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP("MarsRover-Enterprise", "12345678");

  if (esp_now_init() == ESP_OK) {
    esp_now_register_recv_cb(OnDataRecv);
    Serial.println("ESP-NOW Ready!");
  }

  server.on("/", handleRoot);
  server.on("/action", handleAction);
  server.on("/telemetry", handleTelemetryRequest);
  server.begin();
  
  Serial.println("Full Rover Systems Online & Operational!");
}

// --- Main Runtime Loop ---
void loop() {
  server.handleClient();

  // Stream incoming GPS characters into TinyGPS++ parser
  while (Serial2.available() > 0) {
    gps.encode(Serial2.read());
  }

  // Handle live movement command via ESP-NOW glove/controller if active
  if (millis() - lastEspNowPacketTime < 500) {
    executeCommand(espNowManualCmd);
  }

  // Mode Switch Pushbutton Debounce & Execution Logic
  bool reading = digitalRead(BUTTON_PIN);
  if (reading == LOW && lastButtonState == HIGH && millis() - lastButtonPress > 300) {
    currentMode = (currentMode + 1) % 4;
    lastButtonPress = millis();
    
    Serial.print("Switched to Operation Mode: ");
    Serial.println(currentMode);
  }
  lastButtonState = reading;

  // Periodic OLED Dashboard Update
  if (millis() - previousTelemetryMillis >= telemetryInterval) {
    previousTelemetryMillis = millis();

    display.clearDisplay();
    display.setCursor(0, 0);
    display.print(F("Mode: ")); display.println(currentMode);
    display.print(F("Sats: ")); display.println(gps.satellites.value());
    display.print(F("Lat: ")); display.println(gps.location.lat(), 4);
    display.print(F("Lng: ")); display.println(gps.location.lng(), 4);
    display.print(F("Panel: ")); display.print(panelPos); display.println(F(" deg"));
    display.display();
  }
}
