#include <WiFi.h>
#include <WebServer.h>
#include <ESP32Servo.h> // Or standard PWM for L298N

// Pin definitions matching your Edge Detector 2.0 / Mars Rover layout
#define ENA 14
#define IN1 27
#define IN2 26
#define IN3 25
#define IN4 33
#define BUTTON_PIN 4
#define BUZZER_PIN 19

WebServer server(80);

const char* ssid = "Robot-Control";
const char* password = "12345678";

// Operating Modes: 0 = Autonomous, 1 = Manual + Safety, 2 = Suicide, 3 = Diagnostics
int currentMode = 0; 
unsigned long lastButtonPress = 0;
bool buttonState = HIGH;
bool lastButtonState = HIGH;

// HTML Web Dashboard for phone control
const char MAIN_PAGE[] PROGMEM = R"rawliteral(
<!DOCTYPE html>
<html>
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Rover Controller</title>
  <style>
    body { font-family: Arial; text-align: center; background: #111; color: #eee; margin: 0; padding: 20px; }
    h2 { color: #ff4757; }
    .btn { background: #2ed573; color: white; padding: 20px 40px; font-size: 20px; margin: 10px; border: none; border-radius: 10px; cursor: pointer; display: block; width: 80%; max-width: 300px; margin-left: auto; margin-right: auto;}
    .btn:active { background: #26af5f; }
    .stop { background: #ff4757; }
    .stop:active { background: #ff3838; }
    .status { background: #222; padding: 15px; border-radius: 8px; margin-top: 20px; font-family: monospace; }
  </style>
</head>
<body>
  <h2>Rover Web Dashboard</h2>
  <p>Use buttons below to control movement:</p>
  <button class="btn" onclick="sendCommand('forward')">FORWARD</button>
  <button class="btn" onclick="sendCommand('left')">LEFT</button>
  <button class="btn" onclick="sendCommand('right')">RIGHT</button>
  <button class="btn" onclick="sendCommand('backward')">BACKWARD</button>
  <button class="btn stop" onclick="sendCommand('stop')">STOP</button>
  
  <div class="status" id="statusBox">Status: Connected</div>

  <script>
    function sendCommand(cmd) {
      fetch('/action?go=' + cmd)
        .then(response => response.text())
        .then(data => { document.getElementById('statusBox').innerText = "Status: " + data; });
    }
  </script>
</body>
</html>
)rawliteral";

void handleRoot() {
  server.send(200, "text/html", MAIN_PAGE);
}

void handleAction() {
  String cmd = server.arg("go");
  if (cmd == "forward") {
    digitalWrite(IN1, HIGH); digitalWrite(IN2, LOW);
    digitalWrite(IN3, HIGH); digitalWrite(IN4, LOW);
    server.send(200, "text/plain", "Moving Forward");
  } else if (cmd == "backward") {
    digitalWrite(IN1, LOW); digitalWrite(IN2, HIGH);
    digitalWrite(IN3, LOW); digitalWrite(IN4, HIGH);
    server.send(200, "text/plain", "Moving Backward");
  } else if (cmd == "left") {
    digitalWrite(IN1, LOW); digitalWrite(IN2, HIGH);
    digitalWrite(IN3, HIGH); digitalWrite(IN4, LOW);
    server.send(200, "text/plain", "Turning Left");
  } else if (cmd == "right") {
    digitalWrite(IN1, HIGH); digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW); digitalWrite(IN4, HIGH);
    server.send(200, "text/plain", "Turning Right");
  } else if (cmd == "stop") {
    digitalWrite(IN1, LOW); digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW); digitalWrite(IN4, LOW);
    server.send(200, "text/plain", "Stopped");
  } else {
    server.send(400, "text/plain", "Bad Request");
  }
}

void setup() {
  Serial.begin(115200);

  // Motor pins setup
  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  
  // Peripheral pins setup
  pinMode(BUTTON_PIN, INPUT_PULLUP);
  pinMode(BUZZER_PIN, OUTPUT);

  // Set motor speed via PWM
  analogWrite(ENA, 220);

  // Start Access Point
  WiFi.softAP(ssid, password);
  Serial.println("AP Started!");
  Serial.print("IP Address: ");
  Serial.println(WiFi.softAPIP());

  // Web server routes
  server.on("/", handleRoot);
  server.on("/action", handleAction);
  server.begin();
}

void loop() {
  server.handleClient();

  // Mode cycle button logic with simple debounce
  bool reading = digitalRead(BUTTON_PIN);
  if (reading == LOW && lastButtonState == HIGH && millis() - lastButtonPress > 300) {
    currentMode = (currentMode + 1) % 4; // Cycles 0 to 3
    lastButtonPress = millis();
    
    // Audio feedback for mode change
    digitalWrite(BUZZER_PIN, HIGH);
    delay(100);
    digitalWrite(BUZZER_PIN, LOW);
    
    Serial.print("Mode changed to: ");
    Serial.println(currentMode);
  }
  lastButtonState = reading;

  // Mode behaviors
  if (currentMode == 0) {
    // Autonomous Mode placeholder routine
  } else if (currentMode == 1) {
    // Manual + Safety Mode
  } else if (currentMode == 2) {
    // Suicide Mode (raw unfiltered access)
  } else if (currentMode == 3) {
    // Diagnostics Mode (Serial / OLED updates)
  }
}
